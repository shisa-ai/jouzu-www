---
// The Jouzu mark, drawn as SVG dots so it stays crisp without a braille font.
// Glyphs and gradient mirror jouzu's packages/cli/src/presentation.ts.
const MARK = ['⠈⢹ ⡎⢱ ⡇⢸ ⢉⠝ ⡇⢸', '⠣⠜ ⠣⠜ ⠣⠜ ⠮⠤ ⠣⠜'];
const START = [34, 211, 238];
const END = [244, 114, 182];
// Dot offsets within a braille cell, indexed by bit.
const BRAILLE = [[0, 0], [0, 1], [0, 2], [1, 0], [1, 1], [1, 2], [0, 3], [1, 3]];
const GLYPH_WIDTH = 2;
const SPACE_WIDTH = 1.5;
const RADIUS = 0.36;

const dots: { x: number; y: number; fill: string }[] = [];
let width = 0;
MARK.forEach((line, row) => {
  const characters = Array.from(line);
  const glyphCount = characters.filter((character) => character !== ' ').length;
  let glyphIndex = 0;
  let cursor = 0;
  for (const character of characters) {
    if (character === ' ') {
      cursor += SPACE_WIDTH;
      continue;
    }
    const ratio = glyphCount <= 1 ? 0 : glyphIndex / (glyphCount - 1);
    const [r, g, b] = START.map((value, index) => Math.round(value + (END[index] - value) * ratio));
    const bits = character.codePointAt(0)! - 0x2800;
    BRAILLE.forEach(([dx, dy], bit) => {
      if (bits & (1 << bit)) dots.push({ x: cursor + dx, y: row * 4 + dy, fill: `rgb(${r} ${g} ${b})` });
    });
    glyphIndex += 1;
    cursor += GLYPH_WIDTH;
  }
  width = Math.max(width, cursor - 1);
});
const height = MARK.length * 4 - 1;
const viewBox = `${-RADIUS} ${-RADIUS} ${width + RADIUS * 2} ${height + RADIUS * 2}`;
---

<svg class="logo" viewBox={viewBox} role="img" aria-label="Jouzu" xmlns="http://www.w3.org/2000/svg">
  {dots.map((dot) => <circle cx={dot.x} cy={dot.y} r={RADIUS} fill={dot.fill} />)}
</svg>

<style>
  .logo {
    display: block;
    width: min(88%, 22rem);
    height: auto;
  }
</style>
